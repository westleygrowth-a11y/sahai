# Run npm run setup:local to generate local-only database credentials and setup token.
DATABASE_URL=postgresql://sah:CHANGE_ME@localhost:5434/sahai
POSTGRES_USER=sah
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=sahai
APP_URL=http://localhost:3000
SETUP_TOKEN=GENERATE_A_RANDOM_LOCAL_TOKEN
# Set true only behind HTTPS. Default is true when APP_URL uses HTTPS.
SESSION_COOKIE_SECURE=false
# Demo seeding is explicit and must not run on a production database.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=GENERATE_A_RANDOM_DEMO_PASSWORD
# First milestone uses deterministic simulation, not an external AI provider.
AI_MODE=simulation
