{
  "name": "sah-ai-operations-manager",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "node --env-file-if-exists=.env scripts/start-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file=.env scripts/test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:snapshot": "node --env-file=.env scripts/database-snapshot.mjs save",
    "db:restore": "node --env-file=.env scripts/database-snapshot.mjs restore",
    "worker": "tsx --env-file-if-exists=.env scripts/worker.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "test:browser": "tsx --env-file=.env scripts/browser-check.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "prisma": "6.19.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@prisma/internals": "6.19.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "type": "module",
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
